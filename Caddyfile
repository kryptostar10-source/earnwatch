{
	# Kein Let's Encrypt – eigenes, lokales Zertifikat für die LAN-IP
	auto_https disable_redirects
	admin off
}

# HTTP -> HTTPS
http://{$EW_IP} {
	redir https://{$EW_IP}{uri} permanent
}

https://{$EW_IP} {
	tls internal

	# Nur Geräte aus dem Heimnetz (private IP-Bereiche) dürfen zugreifen
	@outside not remote_ip private_ranges
	abort @outside

	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}

	# Große Anfragen schon am Eingang abweisen
	request_body {
		max_size 64KB
	}

	reverse_proxy earnwatch-app:8080 {
		# echte Client-IP erzwingen (gefälschte X-Forwarded-For-Header werden überschrieben)
		header_up X-Forwarded-For {remote_host}
	}
}
