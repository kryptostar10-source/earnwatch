# ===== Netzwerk: eigene IP für das Dashboard =====
# Freie IP in deinem Heimnetz (außerhalb des DHCP-Bereichs deines Routers!)
EW_IP=192.168.1.50
EW_SUBNET=192.168.1.0/24
EW_GATEWAY=192.168.1.1
# Netzwerkkarte der Docker-VM/LXC (mit `ip a` nachsehen, z. B. eth0 oder ens18)
EW_PARENT_IF=eth0

# ===== Sicherheit =====
# Einmal-Token für das allererste Anlegen deines Kontos.
# Erzeugen mit:  openssl rand -base64 24
EW_SETUP_TOKEN=HIER_EIN_LANGES_ZUFALLSTOKEN

TZ=Europe/Berlin
# Abruf-Intervall in Minuten (später auch in der Oberfläche änderbar)
EW_INTERVAL_MIN=60

# ===== Optional: Earn-Apps mitlaufen lassen (docker compose --profile earners up -d) =====
HG_EMAIL=
HG_PASSWORD=
HG_DEVICE=proxmox
# EarnApp-Geräte-ID: "sdk-node-" + 32 Hex-Zeichen. Erzeugen mit:
#   echo sdk-node-$(head -c 16 /dev/urandom | xxd -p)
EARNAPP_UUID=
